name: Continuous Deployment - Helm

on:
  push:
    branches:
      - main  # Adjust your default branch if necessary

jobs:
  deploy:
    name: Deploy to Kubernetes via Helm
    runs-on: ubuntu-latest

    steps:
      - name: Checkout Code
        uses: actions/checkout@v4

      # 1. Set up Helm CLI environment
      - name: Set up Helm
        uses: azure/setup-helm@v4
        with:
          version: 'latest' # Or specify a pinned version like '3.14.0'

      # 2. Configure Kubernetes Cluster Context
      # Replace/configure this section based on your cloud provider (EKS, GKE, AKS, or generic Kubeconfig)
      - name: Authenticate to Kubernetes Cluster
        uses: azure/k8s-set-context@v5
        with:
          method: kubeconfig
          kubeconfig: ${{ secrets.KUBE_CONFIG_DATA }}

      # 3. Optional: Dependency update if your Helm chart relies on subcharts
      - name: Update Helm Dependencies
        run: |
          if [ -f "charts/Chart.yaml" ]; then
            helm dependency update charts/
          fi

      # 4. Perform Helm Upgrade / Install
      - name: Deploy Helm Chart
        run: |
          helm upgrade --install rdashphdia-release ./charts/rdashphdia \
            --namespace production \
            --create-namespace \
            --atomic \
            --cleanup-on-fail \
            --timeout 10m \
            --set image.tag=${{ github.sha }} \
            --set environment=production
