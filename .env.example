# Example environment variables for development
# Copy to .env and update as needed

# CORS origins
ALLOWED_ORIGINS=http://localhost:8000,http://127.0.0.1:8000,http://localhost:8080,http://127.0.0.1:8080

# Learning-prediction API configuration
# For development: use local artifact paths
LEARNING_PREDICTION_MODEL_PATH=artifacts/learning_prediction_model.joblib
LEARNING_PREDICTION_VALIDATION_REPORT=artifacts/learning-validation-report-approved.json

# For production: override with environment-specific paths or remote storage
# LEARNING_PREDICTION_MODEL_PATH=/mnt/secure/models/learning_prediction_model.joblib
# LEARNING_PREDICTION_VALIDATION_REPORT=/mnt/secure/reports/learning-validation-report-approved.json
